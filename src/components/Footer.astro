---
import { SITE } from '../config/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo-link" href="/" aria-label={`${SITE.name} – на главную`}>
        <img
          class="footer-logo"
          src={SITE.logo}
          alt="Ангелина Глухова – психолог и гештальт-терапевт"
          width="720"
          height="240"
          loading="lazy"
        />
      </a>
    </div>

    <nav aria-label="Навигация в подвале">
      <a href="/about">Об Ангелине</a>
      <a href="/services/online">Онлайн</a>
      <a href="/services/batumi">Очно в Батуми</a>
      <a href="/services/couples">Для пар</a>
      <a href="/blog">Публикации</a>
      <a href="/contacts">Контакты</a>
      <a href="/start">Как записаться</a>
    </nav>

    <div class="footer-contact">
      <strong>Связаться и узнать больше</strong>
      <div class="social-links" aria-label="Профили и мессенджеры">
        <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" aria-label="Telegram Ангелины Глуховой">
          <span class="social-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M21.4 4.1 18.5 19c-.2 1.1-.8 1.4-1.7.9l-4.4-3.3-2.1 2c-.2.2-.4.4-.8.4l.3-4.5 8.2-7.4c.4-.3-.1-.5-.5-.2L7.4 13.3 3 11.9c-1-.3-1-1 .2-1.5l17.2-6.6c.8-.3 1.5.2 1 1.3Z" fill="currentColor"/></svg>
          </span>
          <span>Telegram</span>
        </a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Ангелины Глуховой">
          <span class="social-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 2a9.7 9.7 0 0 0-8.5 14.4L2 22l5.8-1.5A10 10 0 1 0 12 2Zm0 17.8a7.8 7.8 0 0 1-4-1.1l-.3-.2-3.4.9.9-3.3-.2-.3A7.8 7.8 0 1 1 12 19.8Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.2l-.7.9c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.3 0-.4.1-.6l.5-.6c.1-.2.1-.4 0-.6L9.6 8c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.6-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.3-.2-.5-.3Z" fill="currentColor"/></svg>
          </span>
          <span>WhatsApp</span>
        </a>
        <a href={SITE.b17} target="_blank" rel="noopener noreferrer" aria-label="Профиль Ангелины Глуховой на B17">
          <span class="social-icon social-icon--b17" aria-hidden="true">b17</span>
          <span>Профиль на B17</span>
        </a>
      </div>
      <a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p>© {new Date().getFullYear()} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-16); border-top: 1px solid var(--color-border); background: var(--color-background-warm); }
  .footer-grid { display: grid; grid-template-columns: minmax(18rem, 1.35fr) minmax(9rem, .8fr) minmax(16rem, 1fr); gap: var(--space-10); color: var(--color-text-secondary); }
  .footer-logo-link { display: block; width: min(100%, 18.5rem); text-decoration: none; }
  .footer-logo { display: block; width: 100%; height: auto; object-fit: contain; object-position: left center; }
  .footer-brand > p, .footer-contact > p { margin-top: var(--space-4); font-size: var(--font-size-sm); }
  nav, .footer-contact { display: grid; align-content: start; gap: var(--space-3); font-size: var(--font-size-sm); }
  .footer-contact strong { color: var(--color-text-primary); }
  nav a:hover, .footer-contact a:hover { color: var(--color-accent); }
  .social-links { display: grid; gap: .72rem; margin-top: .3rem; }
  .social-links a { display: inline-flex; width: fit-content; align-items: center; gap: .68rem; color: var(--color-text-secondary); text-decoration: none; transition: color var(--duration-fast), transform var(--duration-fast); }
  .social-links a:hover { transform: translateX(2px); }
  .social-icon { display: grid; width: 1.25rem; height: 1.25rem; flex: 0 0 auto; place-items: center; color: var(--color-text-primary); }
  .social-icon svg { display: block; width: 100%; height: 100%; }
  .social-icon--b17 { font-size: .66rem; font-weight: 800; letter-spacing: -.04em; text-transform: lowercase; }
  .footer-email { margin-top: var(--space-2); overflow-wrap: anywhere; }
  @media (max-width: 52rem) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-contact { grid-column: 1 / -1; } }
  @media (max-width: 34rem) { .footer-grid { grid-template-columns: 1fr; gap: var(--space-8); } .footer-contact { grid-column: auto; } }
</style>
