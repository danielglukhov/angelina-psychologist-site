---
import Button from '../../ui/Button.astro';
import Container from '../../ui/Container.astro';
import Section from '../../ui/Section.astro';
import { SITE } from '../../../config/site';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  bookingHref?: string;
  contactsHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  eyebrow = 'Начнём с диалога',
  title = 'Можно начать с короткого знакомства',
  description =
    'Не нужно заранее идеально формулировать запрос. Сначала посмотрите, как проходит запись, а затем выберите удобный способ связи.',
  bookingHref = SITE.bookingPath,
  contactsHref = '/contacts',
  imageSrc = '/images/contact.png',
  imageAlt = 'Ангелина Глухова, клинический психолог и гештальт-терапевт',
} = Astro.props;
---

<Section class="contact-cta-block">
  <Container>
    <div class="contact-cta">
      <div class="contact-cta__content">
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
        <p class="lead">{description}</p>

        <div class="contact-cta__actions">
          <Button href={bookingHref}>Записаться на консультацию</Button>
          <Button href={contactsHref} variant="ghost">Посмотреть контакты</Button>
        </div>

        <p class="contact-cta__note">
          На следующей странице – пять простых шагов без неожиданностей и обязательств.
        </p>
      </div>

      <figure class="contact-cta__photo">
        <img
          src={imageSrc}
          alt={imageAlt}
          width="1000"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Container>
</Section>

<style>
  :global(.contact-cta-block) {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .contact-cta {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, 26rem);
    gap: clamp(2.5rem, 4vw, 4rem);
    align-items: center;
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 87% 20%, rgb(255 255 255 / 0.62), transparent 28%),
      color-mix(in srgb, var(--color-accent-soft) 58%, var(--color-background));
    box-shadow: var(--shadow-md);
  }

  .contact-cta::after {
    position: absolute;
    right: -2.5rem;
    bottom: -3.5rem;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    content: '';
    pointer-events: none;
  }

  .contact-cta__content {
    position: relative;
    z-index: 1;
    min-width: 0;
    max-width: 40rem;
  }

  .contact-cta h2 {
    max-width: 15ch;
    margin-top: var(--space-5);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  .contact-cta .lead {
    max-width: 35rem;
    margin-top: var(--space-6);
  }

  .contact-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .contact-cta__note {
    max-width: 34rem;
    margin-top: var(--space-5);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .contact-cta__photo {
    position: relative;
    z-index: 1;
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin: 0;
    justify-self: end;
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
    box-shadow: var(--shadow-lg);
  }

  .contact-cta__photo::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .contact-cta__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  @media (max-width: 56rem) {
    .contact-cta {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
      gap: var(--space-10);
    }
    .contact-cta__photo { width: min(100%, 22rem); }
  }

  @media (max-width: 48rem) {
    .contact-cta { grid-template-columns: 1fr; }
    .contact-cta__photo {
      width: min(100%, 23rem);
      justify-self: center;
      order: -1;
    }
    .contact-cta__content { max-width: none; }
  }

  @media (max-width: 35rem) {
    .contact-cta {
      padding: var(--space-7);
      border-radius: var(--radius-lg);
    }
    .contact-cta h2 {
      max-width: none;
      font-size: clamp(2rem, 11vw, 2.75rem);
    }
    .contact-cta__actions {
      display: grid;
      gap: var(--space-4);
    }
    .contact-cta__actions :global(.button) { width: 100%; }
  }
</style>
