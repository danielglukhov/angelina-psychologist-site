---
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  readingTime: string;
  publishedAt: Date;
  featured?: boolean;
}

const { href, title, description, category, readingTime, publishedAt, featured = false } = Astro.props;
const formattedDate = publishedAt.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<article class:list={['blog-card', { 'blog-card--featured': featured }]}> 
  <a class="blog-card__link" href={href} aria-label={`Читать статью: ${title}`}>
    <div class="blog-card__visual" aria-hidden="true">
      <span class="blog-card__category">{category}</span>
      <svg viewBox="0 0 120 120" role="presentation">
        <path d="M19 79c16-3 21-22 35-29 15-8 30 2 47-10" />
        <path d="M25 92c18-9 30-7 43-20 11-11 12-23 28-31" />
        <circle cx="34" cy="43" r="6" />
        <circle cx="92" cy="76" r="4" />
      </svg>
    </div>
    <div class="blog-card__body">
      <div class="blog-card__meta">
        <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
      </div>
      <h2>{title}</h2>
      <p>{description}</p>
      <span class="blog-card__more">
        Читать статью
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" /></svg>
      </span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-normal) var(--easing-standard), box-shadow var(--duration-normal) var(--easing-standard), border-color var(--duration-normal) var(--easing-standard);
  }
  .blog-card__link { display: grid; height: 100%; grid-template-rows: 12.5rem 1fr; }
  .blog-card__visual { position: relative; display: grid; overflow: hidden; place-items: center; background: var(--color-surface-muted); }
  .blog-card__visual::before { position: absolute; inset: 0; background: radial-gradient(circle at 82% 18%, rgb(255 255 255 / .82), transparent 32%), linear-gradient(145deg, transparent 22%, rgb(69 104 83 / .08)); content: ''; }
  .blog-card__visual svg { position: relative; width: 7.2rem; height: 7.2rem; color: var(--color-accent); opacity: .8; }
  .blog-card__visual path { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
  .blog-card__visual circle { fill: var(--color-accent-soft); stroke: currentColor; stroke-width: 1.3; }
  .blog-card__category { position: absolute; top: 1rem; left: 1rem; z-index: 1; padding: .42rem .68rem; border: 1px solid rgb(69 104 83 / .15); border-radius: var(--radius-pill); background: rgb(255 253 250 / .82); color: var(--color-accent); font-size: .7rem; font-weight: var(--font-weight-extrabold); letter-spacing: .11em; text-transform: uppercase; backdrop-filter: blur(10px); }
  .blog-card__body { display: flex; min-height: 21rem; flex-direction: column; padding: clamp(1.4rem, 3vw, 2rem); }
  .blog-card__meta { display: flex; flex-wrap: wrap; gap: .45rem; color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .blog-card h2 { margin-top: var(--space-4); font-size: clamp(1.45rem, 2.25vw, 2rem); }
  .blog-card p { margin-top: var(--space-4); color: var(--color-text-secondary); line-height: 1.65; }
  .blog-card__more { display: inline-flex; align-items: center; gap: .5rem; margin-top: auto; padding-top: var(--space-8); color: var(--color-accent); font-weight: var(--font-weight-bold); }
  .blog-card__more svg { width: 1.1rem; height: 1.1rem; transition: transform var(--duration-fast) var(--easing-standard); }
  .blog-card__more path { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover:hover) {
    .blog-card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-md); transform: translateY(-4px); }
    .blog-card:hover .blog-card__more svg { transform: translateX(.25rem); }
  }
  .blog-card--featured { grid-column: span 2; }
  .blog-card--featured .blog-card__link { grid-template-columns: minmax(17rem, .8fr) minmax(0, 1.2fr); grid-template-rows: 1fr; }
  .blog-card--featured .blog-card__visual { min-height: 29rem; }
  .blog-card--featured .blog-card__body { min-height: 29rem; justify-content: center; }
  @media (max-width: 50rem) {
    .blog-card--featured { grid-column: auto; }
    .blog-card--featured .blog-card__link { grid-template-columns: 1fr; grid-template-rows: 12.5rem 1fr; }
    .blog-card--featured .blog-card__visual, .blog-card--featured .blog-card__body { min-height: initial; }
  }
</style>
