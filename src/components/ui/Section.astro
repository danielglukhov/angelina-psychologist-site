---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  compact?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = 'section',
  compact = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    'section',
    { 'section--compact': compact },
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
