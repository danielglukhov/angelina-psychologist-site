---
interface Props {
  src?: string;
  alt?: string;
  initials?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  src,
  alt = '',
  initials = '',
  size = 'md',
  class: className = '',
} = Astro.props;
---

<span class:list={['avatar', `avatar--${size}`, className]} aria-hidden={!src && !alt ? 'true' : undefined}>
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <span>{initials}</span>}
</span>

<style>
  .avatar {
    display: inline-grid;
    overflow: hidden;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-muted);
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }

  .avatar--sm { width: 2rem; height: 2rem; font-size: var(--font-size-xs); }
  .avatar--md { width: 3rem; height: 3rem; font-size: var(--font-size-sm); }
  .avatar--lg { width: 4.5rem; height: 4.5rem; font-size: var(--font-size-lg); }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
