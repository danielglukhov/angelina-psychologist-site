---
interface Props {
  orientation?: 'horizontal' | 'vertical';
  class?: string;
}

const { orientation = 'horizontal', class: className = '' } = Astro.props;
---

<div
  class:list={['divider', `divider--${orientation}`, className]}
  role="separator"
  aria-orientation={orientation}
></div>

<style>
  .divider { flex: 0 0 auto; background: var(--color-border); }
  .divider--horizontal { width: 100%; height: 1px; }
  .divider--vertical { width: 1px; min-height: 1.5rem; align-self: stretch; }
</style>
