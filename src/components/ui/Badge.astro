---
interface Props {
  tone?: 'neutral' | 'accent' | 'success' | 'warning' | 'danger';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
  }

  .badge--accent { border-color: transparent; background: var(--color-surface-strong); color: var(--color-accent); }
  .badge--success { border-color: transparent; background: color-mix(in srgb, var(--color-success) 13%, white); color: var(--color-success); }
  .badge--warning { border-color: transparent; background: color-mix(in srgb, var(--color-warning) 13%, white); color: var(--color-warning); }
  .badge--danger { border-color: transparent; background: color-mix(in srgb, var(--color-danger) 13%, white); color: var(--color-danger); }
</style>
