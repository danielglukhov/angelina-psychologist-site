---
interface Props {
  ordered?: boolean;
  class?: string;
}

const { ordered = false, class: className = '' } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

<Tag class:list={['ui-list', className]}><slot /></Tag>

<style>
  .ui-list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .ui-list :global(li) {
    position: relative;
    padding-left: var(--space-6);
    color: var(--color-text-secondary);
  }

  .ui-list :global(li)::before {
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  ol.ui-list {
    counter-reset: ui-list;
  }

  ol.ui-list :global(li) {
    counter-increment: ui-list;
  }

  ol.ui-list :global(li)::before {
    top: 0;
    width: auto;
    height: auto;
    background: none;
    color: var(--color-accent);
    content: counter(ui-list) '.';
    font-weight: var(--font-weight-bold);
  }
</style>
