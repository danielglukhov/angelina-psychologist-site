---
interface Props {
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { label, size = 'md', class: className = '' } = Astro.props;
---

<span
  class:list={['icon', `icon--${size}`, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <slot />
</span>

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    line-height: 0;
  }

  .icon--sm { width: 1rem; height: 1rem; }
  .icon--md { width: 1.25rem; height: 1.25rem; }
  .icon--lg { width: 1.5rem; height: 1.5rem; }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
